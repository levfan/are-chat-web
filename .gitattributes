# 换行符统一：仓库与工作区一律 LF，避免 Windows CRLF 混进脚本与构建产物
* text=auto eol=lf

# Shell 脚本保持 LF
*.sh text eol=lf

# Windows 专用脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换与文本合并
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.jar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
